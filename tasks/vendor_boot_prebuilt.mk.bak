# vendor_boot_prebuilt.mk — Use prebuilt vendor_boot.img instead of source-built.
#
# AOSP constraint: BUILDING_VENDOR_BOOT_IMAGE must be true when
# PRODUCT_BUILD_VENDOR_KERNEL_BOOT_IMAGE is true (board_config.mk:537).
# This makes BOARD_PREBUILT_VENDOR_BOOTIMAGE incompatible with vendor_kernel_boot.
#
# Solution: override the vendor_boot BUILD RECIPE itself.  Task files are
# included after the main Makefile (lines 8010-8019), so this recipe replaces
# the original mkbootimg recipe.  Prerequisites from the original rule are
# still merged (and built), but the recipe body becomes a simple cp.
# This way $(INSTALLED_VENDOR_BOOTIMAGE_TARGET) IS the prebuilt from the start,
# and everything downstream (target-files, OTA payload) uses the correct image.
#
# Included via: -include $(sort $(wildcard device/*/build/tasks/*.mk))
$(info TARGET_KERNEL_DIR=$(TARGET_KERNEL_DIR))

$(info INSTALLED_VENDOR_BOOTIMAGE_TARGET=$(INSTALLED_VENDOR_BOOTIMAGE_TARGET))

ifneq ($(TARGET_KERNEL_DIR),)
_PREBUILT_VB_IMG := $(wildcard $(TARGET_KERNEL_DIR)/vendor_boot.img)
$(info _PREBUILT_VB_IMG=$(_PREBUILT_VB_IMG))
ifneq (,$(_PREBUILT_VB_IMG))
ifdef INSTALLED_VENDOR_BOOTIMAGE_TARGET

# Override vendor_boot recipe: copy prebuilt instead of building from source.
# NOTE: use $(_PREBUILT_VB_IMG) not $< because prerequisites are merged with
# the original rule and $< would resolve to the first original prerequisite.
$(INSTALLED_VENDOR_BOOTIMAGE_TARGET): $(_PREBUILT_VB_IMG)
	@echo "vendor_boot: using prebuilt $(_PREBUILT_VB_IMG)"
	$(hide) cp $(_PREBUILT_VB_IMG) $@

endif # INSTALLED_VENDOR_BOOTIMAGE_TARGET
endif # _PREBUILT_VB_IMG
endif # TARGET_KERNEL_DIR
